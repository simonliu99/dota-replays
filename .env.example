# DotA Replays Configuration
# Copy this file to .env and customize

# OpenDota API key (optional, for higher rate limits)
# Get one at: https://www.opendota.com/api-keys
# OPENDOTA_API_KEY=your-key-here

# Replay storage directory (can be NFS mount)
# REPLAY_DIR=/mnt/nfs/dota-replays

# SQLite database path (keep on local disk, not NFS)
# DB_PATH=./dota_replays.db
