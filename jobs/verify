#!/bin/sh
# switchboard job entry: print the database status, verify the replays, then
# publish the match index.
#
# The worker supplies SWITCHBOARD_BULK (the local folder holding the database)
# and DOTA_REPLAY_DIR (the TrueNAS replay folder). The entry never creates one,
# so a missing mount fails the job instead of writing to the local disk. The
# publish step reads SWITCHBOARD_HUB and SWITCHBOARD_MODULE_TOKEN and exits 1
# when either is unset.

set -eu

cd "$(dirname "$0")/.."

: "${SWITCHBOARD_BULK:?SWITCHBOARD_BULK is not set}"
[ -d "$SWITCHBOARD_BULK" ] || {
    printf '%s: SWITCHBOARD_BULK is not a directory: %s\n' "$0" "$SWITCHBOARD_BULK" >&2
    exit 1
}
: "${DOTA_REPLAY_DIR:?DOTA_REPLAY_DIR is not set}"
[ -d "$DOTA_REPLAY_DIR" ] || {
    printf '%s: DOTA_REPLAY_DIR is not a directory: %s\n' "$0" "$DOTA_REPLAY_DIR" >&2
    exit 1
}

python3 --version
if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'; then
    printf '%s: python3 is below 3.10\n' "$0" >&2
    exit 1
fi

failed=0

# Run one step whatever the earlier ones returned, print its exit code and
# remember a failure: a failed check must not leave the published index stale.
run_step() {
    step=$1
    shift
    if "$@"; then
        code=0
    else
        code=$?
    fi
    printf '%s: %s exited %s\n' "$0" "$step" "$code"
    [ "$code" -eq 0 ] || failed=1
}

run_step status python3 dota_replays.py \
    --db "$SWITCHBOARD_BULK/dota_replays.db" \
    --replay-dir "$DOTA_REPLAY_DIR" \
    --status
run_step verify python3 dota_replays.py \
    --db "$SWITCHBOARD_BULK/dota_replays.db" \
    --replay-dir "$DOTA_REPLAY_DIR" \
    --verify
run_step publish python3 publish.py

[ "$failed" -eq 0 ] || {
    printf '%s: one or more steps failed\n' "$0" >&2
    exit 1
}
